# Copia questo file in `.env.local` e compila con i valori del TUO progetto.
# Dashboard Supabase → Project Settings → API
#   - Project URL           → VITE_SUPABASE_URL
#   - Publishable / anon key → VITE_SUPABASE_ANON_KEY  (chiave pubblica lato client, protetta da RLS)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-or-anon-key>

# Facoltativa. Dove tornano i link delle mail di Supabase (conferma della
# registrazione). Senza: in build la produzione (https://bv-diary.vercel.app),
# in sviluppo l'origine corrente. Vedi src/lib/sito.ts.
# VITE_SITE_URL=https://bv-diary.vercel.app
