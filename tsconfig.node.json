{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  /* vite.config.ts compone la landing (presentazione/build): i file generati
     e i tracciati delle icone sono puri, senza DOM. */
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "presentazione/build",
    "presentazione/js/generati",
    "presentazione/js/pallo.disegno.ts",
    "src/components/ui/Icon.paths.ts"
  ]
}
